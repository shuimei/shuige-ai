{
  "name": "shuige-ai",
  "version": "1.0.0",
  "private": true,
  "description": "水哥 AI — 企业 AI 与数据工程服务落地页",
  "type": "module",
  "scripts": {
    "build": "npm run build:copy && npm run build:css",
    "build:copy": "node scripts/copy-static.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/assets/main.css --minify",
    "dev": "npm run build:copy && tailwindcss -i ./src/input.css -o ./dist/assets/main.css --watch",
    "preview": "npm run build && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
